#!/usr/bin/env bash

# herdr-label: Set the current herdr tab label, and the pane label too when the
# caller is running inside a pane.
#
# Usage: herdr-label "[impl] 認証バグ修正"
#
# Exists so an agent can relabel with one command instead of chaining an env
# var check, a tab rename, and a pane rename: every extra command shows up in
# the transcript as noise and needs its own permission rule.
#
# Without herdr IDs there is no tab to rename. When IDs exist, preserve herdr's
# error so callers can request execution outside a restricted sandbox.

label="$*"
status=0

if [ -z "$label" ]; then
  exit 0
fi

if [ -n "${HERDR_TAB_ID:-}" ]; then
  herdr tab rename "$HERDR_TAB_ID" "$label" >/dev/null || status=$?
fi

if [ -n "${HERDR_PANE_ID:-}" ]; then
  herdr pane rename "$HERDR_PANE_ID" "$label" >/dev/null || status=$?
fi

exit "$status"
